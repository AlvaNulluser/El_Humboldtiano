---
// index.astro — Portada: 1 artículo destacado + 4 secundarios
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticles } from "../content/utils";
import { CATEGORIES, deslugify } from "../utils/slugify";
import { Image } from "astro:assets";
import fallbackImg from "../assets/image-pred.jpg";

const articles = await getArticles();
articles.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const featured =
  articles.find((a) => a.data.destacado) || articles[0] || null;
const secondary = articles.filter((a) => a !== featured).slice(0, 4);

const pageTitle = "El Humboldtiano — Periódico Virtual UAH";
---

<BaseLayout title={pageTitle}>
  <Header />
  <Nav />

  <main id="main-content">
    {
      articles.length === 0 ? (
        <section class="sin-articulos">
          <h2>Próximamente</h2>
          <p>
            Nuestro equipo editorial está preparando los primeros artículos.
            ¡Volvé pronto!
          </p>
        </section>
      ) : (
        <>
          {
            featured && (
              <section class="destacado">
                <article class="articulo-principal">
                  <div class="destacado-imagen">
                    {
                      featured.data.coverImage ? (
                        <img
                          src={featured.data.coverImage}
                          alt={`Imagen del artículo: ${featured.data.title}`}
                          width={800}
                          height={450}
                          loading="eager"
                        />
                      ) : (
                        <Image
                          src={fallbackImg}
                          alt={`Imagen predeterminada del artículo: ${featured.data.title}`}
                          width={800}
                          height={450}
                          quality={80}
                          format="webp"
                          loading="eager"
                        />
                      )
                    }
                  </div>
                  <div class="destacado-contenido">
                    <span class="etiqueta-categoria">
                      {featured.data.category}
                    </span>
                    <h2>
                      <a href={`/articulo/${featured.id}`}>
                        {featured.data.title}
                      </a>
                    </h2>
                    <p class="meta-info">
                      Por {featured.data.author} &middot;{" "}
                      {featured.readingTime} min de lectura
                    </p>
                    {featured.data.resumen && (
                      <p class="resumen">{featured.data.resumen}</p>
                    )}
                    <a
                      href={`/articulo/${featured.id}`}
                      class="leer-mas"
                      aria-label={`Leer artículo: ${featured.data.title}`}
                    >
                      Leer artículo completo &rarr;
                    </a>
                  </div>
                </article>
              </section>
            )
          }

          {secondary.length > 0 && (
            <section class="secundarios">
              <h2 class="titulo-seccion">Más noticias</h2>
              <div class="cuadricula-noticias">
                {secondary.map((article) => (
                  <ArticleCard article={article} />
                ))}
              </div>
            </section>
          )}

          <!-- Category sections -->
          {CATEGORIES.map((cat) => {
            const catArticles = articles
              .filter((a) => a.data.category === cat.name)
              .slice(0, 3);
            return (
              <section class="seccion-categoria">
                <h2 class="titulo-seccion">{cat.name}</h2>
                {catArticles.length > 0 ? (
                  <>
                    <div class="cuadricula-noticias">
                      {catArticles.map((article) => (
                        <ArticleCard article={article} />
                      ))}
                    </div>
                  </>
                ) : (
                  <p class="sin-articulos-cat">
                    Próximamente — suscribite a nuestro{" "}
                    <a href="/rss.xml">feed RSS</a>.
                  </p>
                )}
                <a
                  href={`/categoria/${cat.slug}/1`}
                  class="ver-mas"
                >
                  Ver más en {cat.name} &rarr;
                </a>
              </section>
            );
          })}
        </>
      )
    }
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  /* ── Sin artículos ──────────────────────── */
  .sin-articulos {
    text-align: center;
    padding: 80px 20px;
  }

  .sin-articulos h2 {
    font-size: 2rem;
    color: var(--uah-azul);
    margin-bottom: 10px;
  }

  .sin-articulos p {
    color: #666;
    font-size: 1.1rem;
  }

  /* ── Destacado ──────────────────────────── */
  .articulo-principal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    background: white;
    border: 1px solid #e2e2e2;
    margin-bottom: 50px;
  }

  .destacado-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-right: 4px solid var(--uah-amarillo);
  }

  .destacado-contenido {
    padding: 40px 40px 40px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .destacado-contenido h2 {
    font-size: 2.2rem;
    margin: 10px 0 15px;
    line-height: 1.2;
    color: var(--texto-oscuro);
  }

  .destacado-contenido h2 a {
    text-decoration: none;
    color: inherit;
  }

  .destacado-contenido h2 a:hover {
    color: var(--uah-azul);
  }

  .destacado-contenido .meta-info {
    color: #555;
    font-size: 0.95rem;
    margin-bottom: 15px;
  }

  .resumen {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #444;
    margin-bottom: 20px;
  }

  .leer-mas {
    display: inline-block;
    background: var(--uah-azul);
    color: white;
    padding: 10px 24px;
    text-decoration: none;
    font-weight: 700;
    font-family: var(--fuente-sans);
    font-size: 0.9rem;
    align-self: flex-start;
    transition: background 0.2s;
  }

  .leer-mas:hover {
    background: var(--uah-amarillo);
    color: var(--uah-azul);
  }

  /* ── Secundarios ─────────────────────────── */
  .titulo-seccion {
    font-size: 1.5rem;
    color: var(--uah-azul);
    border-left: 4px solid var(--uah-amarillo);
    padding-left: 15px;
    margin-bottom: 25px;
  }

  .cuadricula-noticias {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 25px;
  }

  /* ── Categorías ─────────────────────────── */
  .seccion-categoria {
    margin-top: 50px;
  }

  .sin-articulos-cat {
    color: #666;
    font-size: 1rem;
    margin-bottom: 15px;
  }

  .sin-articulos-cat a {
    color: var(--uah-azul);
    font-weight: 700;
    text-decoration: underline;
  }

  .ver-mas {
    display: inline-block;
    margin-top: 20px;
    font-family: var(--fuente-sans);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--uah-azul);
    text-decoration: none;
    transition: color 0.2s;
  }

  .ver-mas:hover {
    color: var(--uah-amarillo);
  }

  /* ── Responsive ──────────────────────────── */
  @media (max-width: 768px) {
    main {
      padding: 20px 15px;
    }

    .articulo-principal {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .destacado-imagen img {
      border-right: none;
      border-bottom: 4px solid var(--uah-amarillo);
      height: 250px;
    }

    .destacado-contenido {
      padding: 25px 20px;
    }

    .destacado-contenido h2 {
      font-size: 1.6rem;
    }

    .cuadricula-noticias {
      grid-template-columns: 1fr;
    }
  }

  /* ── Modern Broadsheet Scoped Styles ─────── */

  :global([data-theme="modern"]) main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 36px 20px 64px;
  }

  :global([data-theme="modern"]) .destacado {
    border-bottom: 2px solid var(--editorial-rule-dark);
    padding-bottom: 40px;
    margin-bottom: 48px;
  }

  :global([data-theme="modern"]) .articulo-principal {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 40px;
    background: transparent;
    border: none;
    margin-bottom: 0;
    align-items: center;
  }

  :global([data-theme="modern"]) .destacado-imagen img {
    border: 1px solid var(--editorial-hairline);
    border-right: 1px solid var(--editorial-hairline);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
    height: auto;
  }

  :global([data-theme="modern"]) .destacado-contenido {
    padding: 0;
  }

  :global([data-theme="modern"]) .destacado-contenido .etiqueta-categoria {
    font-family: var(--editorial-font-kicker);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--editorial-gold);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 10px;
    display: inline-block;
  }

  :global([data-theme="modern"]) .destacado-contenido h2 {
    font-family: var(--editorial-font-display);
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--editorial-ink);
    margin: 0 0 14px 0;
    letter-spacing: -0.5px;
  }

  :global([data-theme="modern"]) .destacado-contenido h2 a {
    color: var(--editorial-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  :global([data-theme="modern"]) .destacado-contenido h2 a:hover {
    color: var(--editorial-gold);
  }

  :global([data-theme="modern"]) .destacado-contenido .meta-info {
    font-family: var(--editorial-font-kicker);
    font-size: 0.85rem;
    color: var(--editorial-muted);
    margin-bottom: 16px;
  }

  :global([data-theme="modern"]) .resumen {
    font-family: var(--editorial-font-body);
    font-size: 1.1rem;
    line-height: 1.65;
    color: #374151;
    margin-bottom: 24px;
  }

  :global([data-theme="modern"]) .leer-mas {
    background: var(--editorial-navy);
    color: #ffffff;
    font-family: var(--editorial-font-kicker);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 12px 26px;
    transition: background-color 0.15s ease;
  }

  :global([data-theme="modern"]) .leer-mas:hover {
    background: var(--editorial-gold);
    color: #ffffff;
  }

  :global([data-theme="modern"]) .titulo-seccion {
    font-family: var(--editorial-font-display);
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--editorial-ink);
    border-left: none;
    border-bottom: 1px solid var(--editorial-rule-dark);
    padding-left: 0;
    padding-bottom: 8px;
    margin-bottom: 24px;
    letter-spacing: -0.2px;
  }

  :global([data-theme="modern"]) .secundarios {
    border-bottom: 1px solid var(--editorial-hairline);
    padding-bottom: 48px;
    margin-bottom: 48px;
  }

  :global([data-theme="modern"]) .seccion-categoria {
    border-bottom: 1px solid var(--editorial-hairline);
    padding-bottom: 40px;
    margin-top: 48px;
  }

  :global([data-theme="modern"]) .ver-mas {
    font-family: var(--editorial-font-kicker);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--editorial-navy);
    transition: color 0.15s ease;
  }

  :global([data-theme="modern"]) .ver-mas:hover {
    color: var(--editorial-gold);
  }

  @media (max-width: 768px) {
    :global([data-theme="modern"]) .destacado {
      padding-bottom: 28px;
      margin-bottom: 32px;
    }

    :global([data-theme="modern"]) .articulo-principal {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    :global([data-theme="modern"]) .destacado-imagen img {
      border: 1px solid var(--editorial-hairline);
      height: auto;
      aspect-ratio: 16 / 9;
    }

    :global([data-theme="modern"]) .destacado-contenido {
      padding: 0;
    }

    :global([data-theme="modern"]) .destacado-contenido h2 {
      font-size: 1.65rem;
    }
  }
</style>
