---
// index.astro — Portada: 1 artículo destacado + 4 secciones canónicas organizadas
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticles } from "../content/utils";
import { CATEGORIES } from "../utils/slugify";
import { organizeHomepageArticles } from "../utils/editorialLayout";
import { Image } from "astro:assets";
import fallbackImg from "../assets/image-pred.jpg";

const articles = await getArticles();
const { featured, categories } = organizeHomepageArticles(articles, CATEGORIES);

const formattedFeaturedDate = featured
  ? featured.data.publishDate.toLocaleDateString("es-VE", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

const pageTitle = "El Humboldtiano — Periódico Virtual UAH";
---

<BaseLayout title={pageTitle}>
  <Header />
  <Nav />

  <main id="main-content">
    {
      articles.length === 0 ? (
        <section class="sin-articulos">
          <h2>Próximamente</h2>
          <p>
            Nuestro equipo editorial está preparando los primeros artículos.
            ¡Vuelve pronto!
          </p>
        </section>
      ) : (
        <>
          {featured && (
            <section class="destacado">
              <article class="articulo-principal">
                <div class="destacado-imagen">
                  {featured.data.coverImage ? (
                    <img
                      src={featured.data.coverImage}
                      alt={`Imagen del artículo: ${featured.data.title}`}
                      width={800}
                      height={450}
                      loading="eager"
                    />
                  ) : (
                    <Image
                      src={fallbackImg}
                      alt={`Imagen predeterminada del artículo: ${featured.data.title}`}
                      width={800}
                      height={450}
                      quality={80}
                      format="webp"
                      loading="eager"
                    />
                  )}
                </div>
                <div class="destacado-contenido">
                  <span class="etiqueta-categoria">
                    {featured.data.category}
                  </span>
                  <h2>
                    <a href={`/articulo/${featured.id}`}>
                      {featured.data.title}
                    </a>
                  </h2>
                  <p class="meta-info">
                    Por {featured.data.author} &middot;{" "}
                    <time datetime={featured.data.publishDate.toISOString()}>
                      {formattedFeaturedDate}
                    </time>{" "}
                    &middot; {featured.readingTime} min de lectura
                  </p>
                  {featured.data.resumen && (
                    <p class="resumen">{featured.data.resumen}</p>
                  )}
                  <a
                    href={`/articulo/${featured.id}`}
                    class="leer-mas"
                    aria-label={`Leer artículo completo: ${featured.data.title}`}
                  >
                    Leer artículo completo &rarr;
                  </a>
                </div>
              </article>
            </section>
          )}

          {/* Secciones temáticas estructuradas del periódico */}
          <div class="secciones-periodico">
            {categories.map((cat) => (
              <section class="seccion-categoria" id={cat.slug}>
                <div class="categoria-header">
                  <div class="categoria-titular">
                    <h2 class="titulo-seccion">{cat.name}</h2>
                    <p class="categoria-descripcion">{cat.description}</p>
                  </div>
                  <a
                    href={`/categoria/${cat.slug}/1`}
                    class="ver-mas"
                    aria-label={`Ver sección ${cat.name}`}
                  >
                    Ver sección &rarr;
                  </a>
                </div>

                {cat.articles.length > 0 ? (
                  <div class="cuadricula-noticias">
                    {cat.articles.map((article) => (
                      <ArticleCard article={article} />
                    ))}
                  </div>
                ) : (
                  <div class="tarjeta-seccion-vacia">
                    <div class="invitacion-contenido">
                      <span class="etiqueta-invitacion">
                        Espacio en Redacción
                      </span>
                      <p class="invitacion-texto">
                        {featured && featured.data.category === cat.name
                          ? `La historia principal de esta edición está destacada en portada. ¿Tienes un nuevo proyecto o testimonio para sumar a ${cat.name}?`
                          : `Nuestra redacción está preparando las próximas notas de ${cat.name}. Si eres estudiante, profesor o egresado, puedes publicar aquí.`}
                      </p>
                    </div>
                    <a
                      href={`/categoria/${cat.slug}/1`}
                      class="boton-invitacion"
                    >
                      Explorar sección
                    </a>
                  </div>
                )}
              </section>
            ))}
          </div>

          {/* Cierre editorial comunitario */}
          <section class="llamado-editorial">
            <div class="llamado-contenido">
              <span class="etiqueta-kicker">Comunidad Universitaria</span>
              <h3>¿Quieres publicar en El Humboldtiano?</h3>
              <p>
                El periódico virtual está abierto a las voces de estudiantes,
                profesores y egresados de la Universidad Alejandro de Humboldt.
                Súmate al Club de Cultura y comparte tus crónicas,
                investigaciones o columnas de opinión.
              </p>
              <div class="llamado-acciones">
                <a href="/archivo/1" class="boton-editorial">
                  Explorar Archivo
                </a>
                <a href="/rss.xml" class="boton-editorial">
                  Canal RSS
                </a>
              </div>
            </div>
          </section>
        </>
      )
    }
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 36px 20px 64px;
  }

  /* ── Sin artículos ──────────────────────── */
  .sin-articulos {
    text-align: center;
    padding: 80px 20px;
  }

  .sin-articulos h2 {
    font-family: var(--editorial-font-display);
    font-size: 2rem;
    color: var(--editorial-navy);
    margin-bottom: 10px;
  }

  .sin-articulos p {
    color: var(--editorial-muted);
    font-size: 1.1rem;
  }

  /* ── Destacado Broadsheet ───────────────── */
  .destacado {
    border-bottom: 2px solid var(--editorial-rule-dark);
    padding-bottom: 40px;
    margin-bottom: 48px;
  }

  .articulo-principal {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 40px;
    background: transparent;
    border: none;
    margin-bottom: 0;
    align-items: center;
  }

  .destacado-imagen img {
    border: 1px solid var(--editorial-hairline);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
    height: auto;
  }

  .destacado-contenido {
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .destacado-contenido .etiqueta-categoria {
    font-family: var(--editorial-font-kicker);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--editorial-gold);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 10px;
    display: inline-block;
  }

  .destacado-contenido h2 {
    font-family: var(--editorial-font-display);
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--editorial-ink);
    margin: 0 0 14px 0;
    letter-spacing: -0.5px;
  }

  .destacado-contenido h2 a {
    color: var(--editorial-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .destacado-contenido h2 a:hover {
    color: var(--editorial-gold);
  }

  .destacado-contenido .meta-info {
    font-family: var(--editorial-font-kicker);
    font-size: 0.85rem;
    color: var(--editorial-muted);
    margin-bottom: 16px;
  }

  .destacado-contenido .meta-info time {
    color: var(--editorial-ink);
    font-weight: 600;
  }

  .resumen {
    font-family: var(--editorial-font-body);
    font-size: 1.1rem;
    line-height: 1.65;
    color: #374151;
    margin-bottom: 24px;
  }

  .leer-mas {
    display: inline-block;
    background: var(--editorial-navy);
    color: #ffffff;
    font-family: var(--editorial-font-kicker);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 12px 26px;
    text-decoration: none;
    align-self: flex-start;
    transition: background-color 0.15s ease;
  }

  .leer-mas:hover {
    background: var(--editorial-gold);
    color: #ffffff;
  }

  /* ── Secciones Temáticas Estructuradas ──── */
  .secciones-periodico {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .seccion-categoria {
    border-bottom: 1px solid var(--editorial-hairline);
    padding-bottom: 40px;
  }

  .categoria-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 2px solid var(--editorial-rule-dark);
    margin-bottom: 24px;
    padding-bottom: 10px;
    gap: 20px;
  }

  .categoria-titular {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .categoria-header .titulo-seccion {
    font-family: var(--editorial-font-display);
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--editorial-ink);
    margin: 0;
    padding: 0;
    border: none;
    letter-spacing: -0.2px;
  }

  .categoria-descripcion {
    font-family: var(--editorial-font-kicker);
    font-size: 0.85rem;
    color: var(--editorial-muted);
    margin: 0;
    line-height: 1.4;
  }

  .ver-mas {
    font-family: var(--editorial-font-kicker);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--editorial-navy);
    text-decoration: none;
    transition: color 0.15s ease;
    white-space: nowrap;
    padding-bottom: 2px;
  }

  .ver-mas:hover {
    color: var(--editorial-gold);
  }

  .cuadricula-noticias {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 25px;
  }

  /* ── Tarjeta Sección en Redacción ────────── */
  .tarjeta-seccion-vacia {
    background: var(--editorial-surface);
    border: 1px solid var(--editorial-hairline);
    padding: 24px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .invitacion-contenido {
    max-width: 780px;
  }

  .etiqueta-invitacion {
    font-family: var(--editorial-font-kicker);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--editorial-gold);
    display: inline-block;
    margin-bottom: 6px;
  }

  .invitacion-texto {
    font-family: var(--editorial-font-body);
    font-size: 0.95rem;
    line-height: 1.5;
    color: #4b5563;
    margin: 0;
  }

  .boton-invitacion {
    font-family: var(--editorial-font-kicker);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--editorial-navy);
    border: 1px solid var(--editorial-hairline);
    background: var(--editorial-paper);
    padding: 10px 18px;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .boton-invitacion:hover {
    border-color: var(--editorial-navy);
    color: var(--editorial-ink);
    background: #ffffff;
  }

  /* ── Cierre Editorial ───────────────────── */
  .llamado-editorial {
    margin-top: 56px;
    padding: 40px 24px;
    background: var(--editorial-surface);
    border: 1px solid var(--editorial-hairline);
    border-top: 3px solid var(--editorial-navy);
    text-align: center;
  }

  .llamado-contenido {
    max-width: 680px;
    margin: 0 auto;
  }

  .etiqueta-kicker {
    font-family: var(--editorial-font-kicker);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--editorial-gold);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    display: inline-block;
    margin-bottom: 10px;
  }

  .llamado-contenido h3 {
    font-family: var(--editorial-font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 800;
    color: var(--editorial-ink);
    margin: 0 0 12px 0;
    line-height: 1.2;
  }

  .llamado-contenido p {
    font-family: var(--editorial-font-body);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--editorial-muted);
    margin: 0 0 24px 0;
  }

  .llamado-acciones {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .boton-editorial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--editorial-font-kicker);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--editorial-navy);
    border: 1px solid var(--editorial-hairline);
    background: var(--editorial-paper);
    padding: 10px 22px;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .boton-editorial:hover {
    border-color: var(--editorial-navy);
    color: var(--editorial-ink);
    background: #ffffff;
  }

  /* ── Responsive ──────────────────────────── */
  @media (max-width: 768px) {
    main {
      padding: 20px 15px;
    }

    .destacado {
      padding-bottom: 28px;
      margin-bottom: 32px;
    }

    .articulo-principal {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .destacado-imagen img {
      border: 1px solid var(--editorial-hairline);
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .destacado-contenido {
      padding: 0;
    }

    .destacado-contenido h2 {
      font-size: 1.65rem;
    }

    .categoria-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .cuadricula-noticias {
      grid-template-columns: 1fr;
    }

    .tarjeta-seccion-vacia {
      flex-direction: column;
      align-items: flex-start;
      padding: 18px 16px;
      gap: 16px;
    }

    .boton-invitacion {
      width: 100%;
      text-align: center;
    }

    .llamado-editorial {
      padding: 28px 16px;
      margin-top: 40px;
    }
  }
</style>
