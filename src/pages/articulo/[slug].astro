---
// [slug].astro — Página de artículo completo con SEO meta
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import PrevNext from "../../components/PrevNext.astro";
import fallbackImg from "../../assets/image-pred.jpg";
import { computeReadingTime, getArticles } from "../../content/utils";
import type { ProcessedArticle } from "../../content/utils";
import { slugify } from "../../utils/slugify";

export const getStaticPaths: GetStaticPaths = async () => {
  const articles = await getCollection(
    "articles",
    ({ data }) => data.status === "Listo",
  );
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
};

const { article } = Astro.props as { article: CollectionEntry<"articles"> };
const { data } = article;
const { Content } = await render(article);

const readingTime = computeReadingTime(article.body ?? "");
const seoTitle = `${data.title} — El Humboldtiano`;
const seoDescription =
  data.resumen || `Artículo de ${data.author} en la categoría ${data.category}.`;
const seoImage = data.coverImage || undefined;

const formattedDate = data.publishDate.toLocaleDateString("es-VE", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const isoDate = data.publishDate.toISOString().split("T")[0];
const categorySlug = slugify(data.category);

const breadcrumbItems = [
  { label: "Portada", href: "/" },
  { label: data.category, href: `/categoria/${categorySlug}/1` },
  { label: data.title },
];

const allArticles = await getArticles();
const currentArticle: ProcessedArticle = {
  ...article,
  readingTime,
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={seoImage}
>
  <Header />
  <Nav />

  <main class="articulo-completo" id="main-content">
    <Breadcrumbs items={breadcrumbItems} />
    <article>
      <header class="articulo-cabecera">
        <span class="etiqueta-categoria">{data.category}</span>
        <h1>{data.title}</h1>
        {data.resumen && (
          <p class="articulo-resumen-lead modern-only">{data.resumen}</p>
        )}

        <div class="articulo-meta">
          <p class="autor">Por <strong>{data.author}</strong></p>
          <p class="fecha"><time datetime={isoDate}>{formattedDate}</time></p>
          <p class="tiempo-lectura">{readingTime} min de lectura</p>
        </div>

        {data.tags.length > 0 && (
          <ul class="etiquetas-lista">
            {data.tags.map((tag) => (
              <li class="etiqueta-tag">{tag}</li>
            ))}
          </ul>
        )}
      </header>

      {
        data.coverImage ? (
          <figure class="articulo-imagen">
            <img
              src={data.coverImage}
              alt={`Imagen del artículo: ${data.title}`}
              width={800}
              height={450}
              loading="eager"
            />
          </figure>
        ) : (
          <figure class="articulo-imagen">
            <Image
              src={fallbackImg}
              alt={`Imagen predeterminada del artículo: ${data.title}`}
              width={800}
              height={450}
              quality={80}
              format="webp"
              loading="eager"
            />
          </figure>
        )
      }

      <div class="articulo-cuerpo">
        <Content />
      </div>
    </article>

    <RelatedArticles current={currentArticle} all={allArticles} />
    <PrevNext current={currentArticle} all={allArticles} />
  </main>

  <Footer />
</BaseLayout>

<style>
  .articulo-completo {
    max-width: 750px;
    margin: 0 auto;
    padding: 40px 20px 60px;
  }

  /* ── Cabecera ─────────────────────────────── */
  .articulo-cabecera {
    margin-bottom: 30px;
  }

  .articulo-cabecera h1 {
    font-size: 2.6rem;
    line-height: 1.2;
    margin: 12px 0 20px;
    color: var(--texto-oscuro);
  }

  .articulo-meta {
    color: #555;
    font-size: 0.95rem;
    margin-bottom: 15px;
    padding-bottom: 15px;
    border-bottom: 1px solid #e2e2e2;
  }

  .articulo-meta p {
    margin: 4px 0;
  }

  .autor strong {
    color: var(--uah-azul);
  }

  .fecha time {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--texto-oscuro);
  }

  /* ── Etiquetas ────────────────────────────── */
  .etiquetas-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .etiqueta-tag {
    background: var(--uah-azul);
    color: white;
    padding: 4px 12px;
    font-size: 0.75rem;
    font-family: var(--fuente-sans);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* ── Imagen del artículo ──────────────────── */
  .articulo-imagen {
    margin: 0 0 30px;
  }

  .articulo-imagen img {
    width: 100%;
    height: auto;
    border: 1px solid #e2e2e2;
  }

  /* ── Cuerpo ────────────────────────────────── */
  .articulo-cuerpo {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--texto-oscuro);
  }

  .articulo-cuerpo :global(h2) {
    font-size: 1.6rem;
    color: var(--uah-azul);
    margin-top: 35px;
    margin-bottom: 15px;
  }

  .articulo-cuerpo :global(h3) {
    font-size: 1.3rem;
    color: var(--texto-oscuro);
    margin-top: 25px;
    margin-bottom: 10px;
  }

  .articulo-cuerpo :global(p) {
    margin-bottom: 20px;
  }

  .articulo-cuerpo :global(blockquote) {
    border-left: 4px solid var(--uah-amarillo);
    margin: 25px 0;
    padding: 10px 20px;
    background: #fafafa;
    font-style: italic;
  }

  .articulo-cuerpo :global(img) {
    max-width: 100%;
    height: auto;
    margin: 20px 0;
  }

  .articulo-cuerpo :global(a) {
    color: var(--uah-azul);
    text-decoration: underline;
  }

  .articulo-cuerpo :global(a:hover) {
    color: var(--uah-amarillo);
  }

  .articulo-cuerpo :global(ul),
  .articulo-cuerpo :global(ol) {
    margin: 15px 0;
    padding-left: 25px;
  }

  .articulo-cuerpo :global(li) {
    margin-bottom: 8px;
  }

  .articulo-cuerpo :global(hr) {
    border: none;
    border-top: 1px solid #e2e2e2;
    margin: 40px 0;
  }

  @media (max-width: 768px) {
    .articulo-completo {
      padding: 20px 15px 40px;
    }

    .articulo-cabecera h1 {
      font-size: 1.8rem;
    }

    .articulo-cuerpo {
      font-size: 1.05rem;
    }
  }

  /* ── Modern Broadsheet Longform Scoped Styles ── */

  .modern-only {
    display: none;
  }

  :global([data-theme="modern"]) .modern-only {
    display: block;
  }

  :global([data-theme="modern"]) .articulo-completo {
    max-width: 780px;
    margin: 0 auto;
    padding: 36px 20px 72px;
  }

  :global([data-theme="modern"]) .articulo-cabecera {
    margin-bottom: 28px;
  }

  :global([data-theme="modern"]) .articulo-cabecera .etiqueta-categoria {
    font-family: var(--editorial-font-kicker);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--editorial-gold);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  :global([data-theme="modern"]) .articulo-cabecera h1 {
    font-family: var(--editorial-font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.12;
    color: var(--editorial-ink);
    letter-spacing: -0.5px;
    margin: 12px 0 16px;
  }

  :global([data-theme="modern"]) .articulo-resumen-lead {
    font-family: var(--editorial-font-body);
    font-size: 1.22rem;
    line-height: 1.6;
    color: #374151;
    margin: 0 0 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--editorial-hairline);
    font-weight: 400;
  }

  :global([data-theme="modern"]) .articulo-meta {
    font-family: var(--editorial-font-kicker);
    font-size: 0.82rem;
    color: var(--editorial-muted);
    border-bottom: 1px solid var(--editorial-hairline);
    padding-bottom: 14px;
    margin-bottom: 24px;
  }

  :global([data-theme="modern"]) .autor strong {
    color: var(--editorial-navy);
  }

  :global([data-theme="modern"]) .fecha time {
    color: var(--editorial-ink);
  }

  :global([data-theme="modern"]) .etiqueta-tag {
    background: var(--editorial-navy);
    font-family: var(--editorial-font-kicker);
    font-size: 0.72rem;
    letter-spacing: 0.8px;
  }

  :global([data-theme="modern"]) .articulo-imagen img {
    border: 1px solid var(--editorial-hairline);
  }

  :global([data-theme="modern"]) .articulo-cuerpo {
    font-family: var(--editorial-font-body);
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--editorial-ink);
  }

  /* 3-line drop cap on the opening body paragraph */
  :global([data-theme="modern"]) .articulo-cuerpo > :global(p:first-of-type::first-letter) {
    font-family: var(--editorial-font-display);
    font-size: 4.2rem;
    line-height: 0.85;
    float: left;
    margin-top: 6px;
    margin-right: 12px;
    margin-bottom: -4px;
    font-weight: 800;
    color: var(--editorial-navy);
  }

  :global([data-theme="modern"]) .articulo-cuerpo :global(h2) {
    font-family: var(--editorial-font-display);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--editorial-ink);
    letter-spacing: -0.3px;
    margin-top: 40px;
    margin-bottom: 16px;
  }

  :global([data-theme="modern"]) .articulo-cuerpo :global(h3) {
    font-family: var(--editorial-font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--editorial-ink);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  :global([data-theme="modern"]) .articulo-cuerpo :global(blockquote) {
    border-left: 4px solid var(--editorial-gold);
    background: rgba(180, 83, 9, 0.04);
    font-family: var(--editorial-font-display);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--editorial-navy);
    padding: 16px 24px;
    margin: 32px 0;
  }

  :global([data-theme="modern"]) .articulo-cuerpo :global(a) {
    color: var(--editorial-navy);
    text-decoration: underline;
    text-decoration-color: var(--editorial-gold);
    text-underline-offset: 3px;
  }

  :global([data-theme="modern"]) .articulo-cuerpo :global(a:hover) {
    color: var(--editorial-gold);
  }

  :global([data-theme="modern"]) .articulo-cuerpo :global(hr) {
    border-top: 1px solid var(--editorial-hairline);
  }
</style>
