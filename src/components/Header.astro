---
// Header.astro — Mástil del periódico broadsheet con dateline bar
import { EDITORIAL_CONFIG } from "../config/editorial";

const currentDate = new Date().toLocaleDateString("es-VE", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const formattedDate = currentDate.charAt(0).toUpperCase() + currentDate.slice(1);
---

<header class="encabezado" role="banner">
  <div class="dateline-bar">
    <span class="dateline-date">{formattedDate}</span>
    <span class="dateline-location">{EDITORIAL_CONFIG.location}</span>
    <span class="dateline-edition">{EDITORIAL_CONFIG.edition}</span>
  </div>

  <h1 class="titulo-principal">
    <a href="/">{EDITORIAL_CONFIG.name}</a>
  </h1>
</header>

<style>
  .encabezado {
    text-align: center;
    padding: 0;
    border-bottom: 2px solid var(--editorial-rule-dark);
    background-color: var(--editorial-paper);
  }

  .dateline-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 24px;
    border-top: 1px solid var(--editorial-hairline);
    border-bottom: 1px solid var(--editorial-hairline);
    font-family: var(--editorial-font-kicker);
    font-size: 0.78rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--editorial-muted);
    font-weight: 600;
  }

  .titulo-principal {
    font-family: var(--editorial-font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.2rem);
    font-weight: 800;
    margin: 16px 0 14px;
    color: var(--editorial-navy);
    letter-spacing: -0.5px;
    text-transform: none;
    line-height: 1.05;
  }

  .titulo-principal a {
    color: var(--editorial-navy);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .titulo-principal a:hover {
    color: var(--editorial-gold);
  }

  @media (max-width: 768px) {
    .dateline-bar {
      flex-direction: column;
      gap: 4px;
      padding: 6px 12px;
      font-size: 0.72rem;
    }

    .titulo-principal {
      font-size: 2.2rem;
      margin: 12px 0 10px;
    }
  }
</style>
